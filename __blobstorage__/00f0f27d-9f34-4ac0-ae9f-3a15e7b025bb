: "9604eff5-f941-26e7-d0b4-ed3a74b68288", "game_type": 0}, {"id": 93006, "created_at": 1521207013, "name": "Teamchef", "slug": "teamchef", "updated_at": 1670950642, "checksum": "75f5dbc1-e385-e59b-c610-9b123d4df25e", "game_type": 0}, {"id": 25137, "created_at": 1477220435, "first_release_date": 410140800, "game_modes": [1], "genres": [33], "involved_companies": [40972], "name": "Floppy Frenzy", "platforms": [13], "release_dates": [59359], "slug": "floppy-frenzy", "summary": "In Floppy Frenzy, players guide a floppy disk through a maze, being careful to avoid dust and magnets. Players can trap magnets in a trap, while using traps on dust will reduce the dust and make it harmless. Be warned though, as magnets get free after a while or if they touch another trap after they are trapped.\n\nThere is also a timer. If the player does not use their traps on all the enemies within the time limit, they will die. If the player loses all three of their lives the game is then over. After each level the player gets to a bonus score screen, which shows how well they did within the time limit. The faster a player used their traps on all the enemies, the higher the bonus score multiplier.", "themes": [1], "updated_at": 1670950644, "checksum": "64279032-3daa-ead7-b605-b22cbde20940", "game_type": 0}, {"id": 94565, "created_at": 1521408219, "first_release_date": 788918400, "involved_companies": [79915, 79916], "name": "Dime City", "platforms": [13], "release_dates": [171154], "slug": "dime-city", "summary": "Dime City, a fictitious American town in the last 30 years of the last century, is the scene of this business simulation in the gangster environment. With one of 4 companies you try to reach your aims \u2013 being governor and godfather of Dime City. With (bank-)raids, blackmails or prostitution you raise your money. With the money you can buy cars and people for your crime-activities, stocks or immovables. Worth mentioning are the sudden attacks to your competitors. These are little top-down action games.", "updated_at": 1670950647, "checksum": "d92cf3e7-7a81-dbc8-b9f5-184b7ff4a1c3", "game_type": 0}, {"id": 94578, "created_at": 1521408329, "name": "Warrior of Ras: Volume I - Dunzhin", "slug": "warrior-of-ras-volume-i-dunzhin", "updated_at": 1670950662, "checksum": "b5b1a19e-008f-e0c0-9749-cd347788fa6e", "game_type": 0}, {"id": 94574, "created_at": 1521408306, "name": "CeeBot-A", "slug": "ceebot-a", "updated_at": 1670950670, "checksum": "98d82ced-a925-a757-f837-266db531210f", "game_type": 0}, {"id": 93004, "created_at": 1521206994, "name": "Raving Mad", "slug": "raving-mad", "updated_at": 1670950671, "checksum": "9ebf1f45-848c-1cfd-464f-b847ddc613ec", "game_type": 0}, {"id": 47116, "created_at": 1499714082, "first_release_date": 757296000, "game_modes": [1], "genres": [30], "involved_companies": [186839, 186840], "name": "Crystal Caliburn", "platforms": [6, 14], "release_dates": [388784, 388785], "slug": "crystal-caliburn", "summary": "Crystal Caliburn is a digital pinball simulator themed around the legend of King Arthur. It was produced by Japanese developer LittleWing and published in 1993.", "updated_at": 1670950677, "checksum": "44ad53bb-bf1c-7a51-1c83-7da619234337", "game_type": 0}, {"id": 92999, "created_at": 1521206971, "name": "Energy Warrior + Molecule Man", "slug": "energy-warrior-plus-molecule-man", "updated_at": 1670950682, "checksum": "4c321e55-b228-6ef0-aad3-7b7682707a22", "game_type": 0}, {"id": 70722, "created_at": 1506601787, "name": "Trapfall", "slug": "trapfall", "summary": "Clone of Pitfall! for multiple home computers.", "themes": [1], "updated_at": 1670950685, "checksum": "1368eb16-ee8d-c54c-45b4-b0a278d5892b", "game_type": 0}, {"id": 92998, "created_at": 1521206966, "name": "Chess88", "slug": "chess88", "updated_at": 1670950688, "checksum": "7f5484da-c26b-c1f7-88c2-71e66f92ff05", "game_type": 0}, {"id": 92995, "created_at": 1521206946, "name": "Linkz", "slug": "linkz", "updated_at": 1670950710, "checksum": "3e745151-63