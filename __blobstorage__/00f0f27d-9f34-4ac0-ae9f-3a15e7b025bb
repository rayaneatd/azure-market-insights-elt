e": 599529600, "game_modes": [1], "genres": [5], "involved_companies": [114470], "name": "Meganova", "platforms": [15, 26, 25, 27], "release_dates": [241361, 241362, 241363, 241364], "slug": "meganova", "storyline": "Phillipus Sunset, interstellar mega-pilot of the Terra 1 confederation, has stolen the SPROCKET-SYSTEM, taking it from the terrible Drowhar empire.\n\nYou enter the caves of Otnirebal and when you leave them you are absorbed by an imperial giganave where your old Drowharian friends are waiting for you. Arm yourself with courage and pray what you know, the battle will be decisive ...", "summary": "Classic side scrolling shoot'em up. Three levels and multiple power ups", "themes": [1, 18], "updated_at": 1670948118, "checksum": "be9b9cb5-11f9-fb8a-4b02-4bd6476adcbd", "game_type": 0}, {"id": 93288, "created_at": 1521211265, "name": "El Juli presenta: Torero - Arte y Pasion en la Arena", "slug": "el-juli-presenta-torero-arte-y-pasion-en-la-arena", "updated_at": 1670948120, "checksum": "161b4928-ba39-835e-8090-7a11a137d5a3", "game_type": 0}, {"id": 93287, "created_at": 1521211262, "name": "Leader Board Par 4", "slug": "leader-board-par-4", "updated_at": 1670948134, "checksum": "31d56f5f-bd98-1fad-12f3-5f1a8087df04", "game_type": 0}, {"id": 100082, "created_at": 1525004747, "name": "Smart Games Challenge #1", "slug": "smart-games-challenge-number-1", "updated_at": 1670948138, "checksum": "48cbaf7a-f2b0-bb99-a6e0-f12c6704fb59", "game_type": 0}, {"id": 80047, "created_at": 1515177507, "first_release_date": 1158278400, "game_modes": [1], "genres": [5], "name": "Astro Fury", "platforms": [6], "release_dates": [165328], "slug": "astro-fury", "summary": "You are alone against the whole hip of spaceships attacking the planet! Their furious attacks don't let you move freely, their space supremacy is strong, their force is obvious as never before. Lots of alien enemies ruled by the monster-boss are here and there is no escape from them in the galaxy. Unless you learn the tactics and start to fight with them! Pull yourself together, don't be scared by the mission and the rival's strength - go ahead and prove you are the one to save the planet from the invaders! Astro Fury is an excellent experience for those who adore fighting, changing weapons and defeating evil opponents. Alone against the huge army! What bravery must you have to stop them - still nothing is impossible! You've got the equipment, the ship, and the talent of an unsurpassed pilot! Astro Fury will be a great campaign with furious onslaught, aggressive attacks and you must be ready for swift moves and exact shooting! Astro Fury contains three skill levels, numerous stages that will end with a final battle against the boss. You are free to get upgrades - if you fight well enough and destroy many aircrafts. Every time you are attacked you need to dodge the bullet, the rocket or whatever you are shot with. Otherwise the number of lives will be decreased. There are 10 big levels with stages inside. Each is full of a wide variety of aircrafts that differ in size, level of danger and speed. You need to adjust to the new types of enemies quickly or you will be the one defeated today!", "themes": [1], "updated_at": 1670948151, "checksum": "d2d020d1-3afe-ae92-d2ab-834a3a7d61b4", "game_type": 0}, {"id": 78646, "created_at": 1514164463, "name": "Ka-52 Team Alligator", "slug": "ka-52-team-alligator", "updated_at": 1670948152, "checksum": "a11a08d6-f6a3-7e00-6477-a43df90c0c82", "game_type": 0}, {"id": 93280, "created_at": 1521211223, "name": "Rode Quest", "slug": "rode-quest", "updated_at": 1670948170, "checksum": "c312f5e8-c2e3-1a8b-fba7-f72769e21e1b", "game_type": 0}, {"id": 94381, "created_at": 1521401117, "name": "Trifide", "slug": "trifide", "updated_at": 1670948170, "checksum": "f4ec6540-5660-d93c-c5d9-9bf4babf9540", "game_type": 0}, {"id": 40051, "created_at": 1498469166, "first_release_date": 412905600, "genres": [8], "name": "Jump Coaster", "platforms": [52], "release_da